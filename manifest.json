{
  "manifest_version": 3,
  "name": "Buzzline",
  "version": "0.3.0",
  "minimum_chrome_version": "105",
  "description": "Eye-guiding color gradients that pull your eyes through long blocks of text.",
  "permissions": ["storage", "activeTab", "contextMenus"],
  "background": { "service_worker": "src/background.js" },
  "commands": {
    "toggle-enabled": { "suggested_key": { "default": "Alt+B" }, "description": "Toggle Buzzline coloring" },
    "sprint-page": { "suggested_key": { "default": "Alt+S" }, "description": "Sprint-read the selection or the page" },
    "open-reader": { "description": "Open the Buzzline reader" }
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Buzzline"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/core.js", "src/sprint.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
