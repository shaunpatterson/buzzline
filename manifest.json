{
  "manifest_version": 3,
  "name": "Buzzline",
  "version": "0.1.0",
  "description": "Eye-guiding color gradients that pull your eyes through long blocks of text.",
  "permissions": ["storage", "activeTab", "clipboardRead"],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Buzzline"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/sprint.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
